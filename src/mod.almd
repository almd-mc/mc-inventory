// Minecraft inventory window management for 1.21.1.
// Corresponds to PrismarineJS/prismarine-windows.
//
// Handles container GUIs: player inventory, chests, crafting table,
// furnace, etc. with click actions and slot mapping.
//
// Usage:
//   import mc_inventory
//   let win = mc_inventory.open_chest(1, "Chest")
//   let win2 = mc_inventory.click(win, 0, Left, false)

// --- Types ---

type Slot = {
  item_id: Int,
  count: Int,
  damage: Int,
}

type WindowType =
  | PlayerInventory
  | Chest
  | DoubleChest
  | CraftingTable
  | Furnace
  | Anvil
  | EnchantingTable
  | Dispenser
  | ShulkerBox
  | Generic(String)

type ClickMode = | Left | Right | ShiftLeft | ShiftRight | NumberKey(Int) | Drop | DropStack

type Window = {
  id: Int,
  window_type: WindowType,
  title: String,
  slots: List[Option[Slot]],
  cursor: Option[Slot],
}

// --- Window sizes ---

fn window_size(wt: WindowType) -> Int = {
  match wt {
    PlayerInventory => 46,
    Chest => 63,           // 27 container + 36 player
    DoubleChest => 90,     // 54 container + 36 player
    CraftingTable => 46,   // 10 craft + 36 player
    Furnace => 39,         // 3 furnace + 36 player
    Anvil => 39,           // 3 anvil + 36 player
    EnchantingTable => 38, // 2 enchant + 36 player
    Dispenser => 45,       // 9 dispenser + 36 player
    ShulkerBox => 63,      // 27 shulker + 36 player
    Generic(_name) => 63,
  }
}

fn container_size(wt: WindowType) -> Int = {
  match wt {
    PlayerInventory => 46,
    Chest => 27,
    DoubleChest => 54,
    CraftingTable => 10,
    Furnace => 3,
    Anvil => 3,
    EnchantingTable => 2,
    Dispenser => 9,
    ShulkerBox => 27,
    Generic(_name) => 27,
  }
}

// --- Window creation ---

fn new_window(id: Int, wt: WindowType, title: String) -> Window = {
  let size = window_size(wt)
  var slots: List[Option[Slot]] = []
  for _i in 0..<size {
    slots = slots + [none]
  }
  { id: id, window_type: wt, title: title, slots: slots, cursor: none }
}

fn open_player_inventory() -> Window =
  new_window(0, PlayerInventory, "Inventory")

fn open_chest(id: Int, title: String) -> Window =
  new_window(id, Chest, title)

fn open_double_chest(id: Int, title: String) -> Window =
  new_window(id, DoubleChest, title)

fn open_crafting_table(id: Int) -> Window =
  new_window(id, CraftingTable, "Crafting")

fn open_furnace(id: Int) -> Window =
  new_window(id, Furnace, "Furnace")

// --- Slot access ---

fn get_slot(win: Window, index: Int) -> Option[Slot] = {
  if index < 0 or index >= list.length(win.slots) then none
  else list.get(win.slots, index) ?? none
}

fn set_slot(win: Window, index: Int, slot: Option[Slot]) -> Window = {
  if index < 0 or index >= list.length(win.slots) then win
  else {
    var new_slots: List[Option[Slot]] = []
    for i in 0..<list.length(win.slots) {
      if i == index then new_slots = new_slots + [slot]
      else new_slots = new_slots + [list.get(win.slots, i) ?? none]
    }
    { ...win, slots: new_slots }
  }
}

// --- Slot mapping for player inventory within container windows ---

// In container windows, player inventory starts after container slots.
fn player_inventory_start(wt: WindowType) -> Int = container_size(wt)

fn hotbar_start(wt: WindowType) -> Int = container_size(wt) + 27

// Absolute slot index for player hotbar slot (0-8).
fn hotbar_slot(wt: WindowType, slot: Int) -> Int = hotbar_start(wt) + slot

// Absolute slot index for player main inventory slot (0-26).
fn main_inv_slot(wt: WindowType, slot: Int) -> Int = player_inventory_start(wt) + slot

// --- Click simulation ---

fn empty_slot() -> Option[Slot] = none

fn can_stack(a: Option[Slot], b: Option[Slot]) -> Bool = {
  match a {
    none => false,
    some(sa) => match b {
      none => false,
      some(sb) => sa.item_id == sb.item_id and sa.damage == sb.damage,
    },
  }
}

fn click(win: Window, slot_index: Int, mode: ClickMode, _outside: Bool) -> Window = {
  let slot = get_slot(win, slot_index)
  let cursor = win.cursor
  match mode {
    Left => {
      // Left click: swap cursor and slot
      let w = set_slot(win, slot_index, cursor)
      { ...w, cursor: slot }
    },
    Right => {
      // Right click: place one from cursor, or pick up half
      match cursor {
        none => {
          // Pick up half of slot
          match slot {
            none => win,
            some(s) => {
              let half = s.count / 2
              let remain = s.count - half
              let picked: Option[Slot] = if half > 0 then some({ ...s, count: half }) else none
              let left: Option[Slot] = if remain > 0 then some({ ...s, count: remain }) else none
              let w = set_slot(win, slot_index, left)
              { ...w, cursor: picked }
            },
          }
        },
        some(c) => {
          // Place one from cursor
          match slot {
            none => {
              let placed: Option[Slot] = some({ ...c, count: 1 })
              let new_cursor: Option[Slot] = if c.count > 1 then some({ ...c, count: c.count - 1 }) else none
              let w = set_slot(win, slot_index, placed)
              { ...w, cursor: new_cursor }
            },
            some(s) => {
              if s.item_id == c.item_id and s.damage == c.damage then {
                // Stack one onto existing
                let new_slot: Option[Slot] = some({ ...s, count: s.count + 1 })
                let new_cursor: Option[Slot] = if c.count > 1 then some({ ...c, count: c.count - 1 }) else none
                let w = set_slot(win, slot_index, new_slot)
                { ...w, cursor: new_cursor }
              } else {
                // Swap
                let w = set_slot(win, slot_index, some(c))
                { ...w, cursor: some(s) }
              }
            },
          }
        },
      }
    },
    _ => win,
  }
}

// --- Query helpers ---

fn count_item(win: Window, item_id: Int) -> Int = {
  var total = 0
  for s in win.slots {
    match s {
      some(slot) => { if slot.item_id == item_id then total = total + slot.count else () },
      none => (),
    }
  }
  total
}

fn first_empty(win: Window) -> Option[Int] = {
  var found: Option[Int] = none
  for i in 0..<list.length(win.slots) {
    match found {
      some(_f) => (),
      none => {
        let s = list.get(win.slots, i) ?? none
        match s {
          none => { found = some(i) },
          some(_slot) => (),
        }
      },
    }
  }
  found
}

fn find_item(win: Window, item_id: Int) -> Option[Int] = {
  var found: Option[Int] = none
  for i in 0..<list.length(win.slots) {
    match found {
      some(_f) => (),
      none => {
        let s = list.get(win.slots, i) ?? none
        match s {
          some(slot) => { if slot.item_id == item_id then found = some(i) else () },
          none => (),
        }
      },
    }
  }
  found
}

fn is_full(win: Window) -> Bool = {
  var has_empty = false
  for s in win.slots {
    match s {
      none => { has_empty = true },
      some(_slot) => (),
    }
  }
  not has_empty
}

// --- Tests ---

test "window_size" where [
  "player" [wt = PlayerInventory, want = 46],
  "chest"  [wt = Chest, want = 63],
  "double" [wt = DoubleChest, want = 90],
  "craft"  [wt = CraftingTable, want = 46],
  "furnace" [wt = Furnace, want = 39],
] {
  assert_eq(window_size(wt), want)
}

test "container_size" where [
  "chest"  [wt = Chest, want = 27],
  "double" [wt = DoubleChest, want = 54],
  "furnace" [wt = Furnace, want = 3],
] {
  assert_eq(container_size(wt), want)
}

test "new_window slot count" {
  let win = open_chest(1, "Chest")
  assert_eq(list.length(win.slots), 63)
}

test "set_slot and get_slot" {
  let win = open_chest(1, "Test")
  let item: Option[Slot] = some({ item_id: 1, count: 64, damage: 0 })
  let win2 = set_slot(win, 5, item)
  match get_slot(win2, 5) {
    some(s) => {
      assert_eq(s.item_id, 1)
      assert_eq(s.count, 64)
    },
    none => assert(false),
  }
}

test "left click - swap" {
  let win = open_chest(1, "Test")
  let win2 = set_slot(win, 0, some({ item_id: 10, count: 32, damage: 0 }))
  // Click slot 0 with empty cursor: pick up item
  let win3 = click(win2, 0, Left, false)
  match win3.cursor {
    some(c) => assert_eq(c.item_id, 10),
    none => assert(false),
  }
  match get_slot(win3, 0) {
    none => assert(true),
    some(_s) => assert(false),
  }
}

test "right click - pick half" {
  let win = open_chest(1, "Test")
  let win2 = set_slot(win, 0, some({ item_id: 5, count: 10, damage: 0 }))
  let win3 = click(win2, 0, Right, false)
  match win3.cursor {
    some(c) => assert_eq(c.count, 5),
    none => assert(false),
  }
  match get_slot(win3, 0) {
    some(s) => assert_eq(s.count, 5),
    none => assert(false),
  }
}

test "right click - place one" {
  let win = open_chest(1, "Test")
  let win2 = { ...win, cursor: some({ item_id: 3, count: 5, damage: 0 }) }
  let win3 = click(win2, 0, Right, false)
  match get_slot(win3, 0) {
    some(s) => {
      assert_eq(s.item_id, 3)
      assert_eq(s.count, 1)
    },
    none => assert(false),
  }
  match win3.cursor {
    some(c) => assert_eq(c.count, 4),
    none => assert(false),
  }
}

test "count_item" {
  let win = open_chest(1, "Test")
  let win2 = set_slot(set_slot(win, 0, some({ item_id: 1, count: 32, damage: 0 })), 5, some({ item_id: 1, count: 16, damage: 0 }))
  assert_eq(count_item(win2, 1), 48)
  assert_eq(count_item(win2, 2), 0)
}

test "first_empty" {
  let win = open_chest(1, "Test")
  match first_empty(win) {
    some(i) => assert_eq(i, 0),
    none => assert(false),
  }
  let win2 = set_slot(win, 0, some({ item_id: 1, count: 1, damage: 0 }))
  match first_empty(win2) {
    some(i) => assert_eq(i, 1),
    none => assert(false),
  }
}

test "find_item" {
  let win = open_chest(1, "Test")
  let win2 = set_slot(win, 3, some({ item_id: 42, count: 1, damage: 0 }))
  match find_item(win2, 42) {
    some(i) => assert_eq(i, 3),
    none => assert(false),
  }
  match find_item(win2, 99) {
    some(_i) => assert(false),
    none => assert(true),
  }
}

test "hotbar_slot mapping" {
  assert_eq(hotbar_slot(Chest, 0), 54)
  assert_eq(hotbar_slot(Chest, 8), 62)
  assert_eq(hotbar_slot(PlayerInventory, 0), 73)
}

test "can_stack" {
  let a: Option[Slot] = some({ item_id: 1, count: 10, damage: 0 })
  let b: Option[Slot] = some({ item_id: 1, count: 5, damage: 0 })
  let c: Option[Slot] = some({ item_id: 2, count: 5, damage: 0 })
  assert(can_stack(a, b))
  assert(not can_stack(a, c))
  assert(not can_stack(a, none))
  assert(not can_stack(none, b))
}

test "is_full" {
  let win = open_chest(1, "Test")
  assert(not is_full(win))
}
